generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  isAdmin        Boolean   @default(false)
  accounts       Account[]
  sessions       Session[]
  bookings       Booking[]
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id        BigInt   @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  phone     String
  date      DateTime // date of appointment
  time      String // timeslot (e.g. "14:00")
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Availability {
  id     Int      @id @default(autoincrement())
  start  DateTime
  end    DateTime
  reason String?
}

model Contact {
  id          BigInt   @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String
  countryCode String   @map("country_code")
  phone       String
  message     String

  // Prisma'ya bu modelin veritabanındaki 'contacts' tablosuna
  // karşılık geldiğini söylüyoruz.
  @@map("contacts")
}

enum ClientPlan {
  PILOT
  STARTER
  GROWTH
}

enum ClientStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

// AI Receptionist SaaS customer (created from a completed Stripe Checkout)
model Client {
  id                       String       @id @default(uuid())
  email                    String       @unique
  businessName             String
  phone                    String?
  stripeCustomerId         String       @unique
  stripeSubscriptionId     String?      @unique // null for the one-off pilot
  retellAgentId            String?      @unique // assigned manually once the agent is provisioned
  plan                     ClientPlan
  status                   ClientStatus @default(ACTIVE)
  monthlyMinuteLimit       Int
  minutesUsedCurrentPeriod Int          @default(0)
  limitNotifiedAt          DateTime? // set once when the pilot-exhausted email is sent; cleared on a new paid period
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  callLogs                 CallLog[]
}

model CallLog {
  id              String   @id @default(uuid())
  clientId        String
  retellCallId    String   @unique
  callerNumber    String?
  durationSeconds Int
  billedMinutes   Int
  summary         String?
  isEmergency     Boolean  @default(false)
  createdAt       DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

// Passwordless client login. `token` stores the SHA-256 hash of the emailed token, never the raw value.
model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// Personal voice-demo invite: gates the paid Retell demo and tracks each prospect.
model DemoInvite {
  id           String    @id @default(cuid())
  token        String    @unique
  businessName String
  contactName  String?
  email        String
  phone        String?
  notes        String?
  source       String    @default("outbound_email") // "outbound_email" | "inbound_form"
  maxCalls     Int       @default(3)
  callsUsed    Int       @default(0)
  openedAt     DateTime?
  lastCalledAt DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
}

// Embeddable multi-tenant web chat widget (one row per client website)
model ChatWidget {
  id                 String       @id @default(cuid())
  slug               String       @unique // e.g. "trg-plumbing"
  businessName       String
  industry           String       @default("general")
  assistantName      String       @default("Sam")
  primaryColor       String       @default("#0f172a")
  greetingMessage    String
  services           String
  serviceArea        String?
  businessHours      String?
  customInstructions String?
  bookingUrl         String?
  notifyEmail        String?
  notifyPhone        String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  leads              WidgetLead[]
}

model WidgetLead {
  id             String     @id @default(cuid())
  widgetId       String
  conversationId String     @unique // one lead per chat; later turns enrich the same row
  callerName     String?
  phone          String?
  email          String?
  suburb         String?
  issue          String?
  urgency        String?
  preferredTime  String? // asked when the widget has no booking URL, e.g. "Friday afternoon"
  transcript     String?
  createdAt      DateTime   @default(now())

  widget ChatWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([widgetId, createdAt])
}
